{
  "name": "MiningGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Remotes": {
        "$className": "Folder",
        "MineBlockRequest": {
          "$className": "RemoteEvent"
        }
      },
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterPack": {
      "Pickaxe": {
        "$className": "Tool",
        "$properties": {
          "CanBeDropped": false,
          "RequiresHandle": true,
          "ToolTip": "Mine blocks"
        },
        "Handle": {
          "$className": "Part",
          "$properties": {
            "Anchored": false,
            "CanCollide": false,
            "Color": [
              0.45,
              0.32,
              0.2
            ],
            "Material": "Wood",
            "Size": [
              0.35,
              3.5,
              0.35
            ]
          }
        },
        "MineClient": {
          "$path": "src/starterpack/Pickaxe/MineClient.client.luau"
        }
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      },
      "KillZone": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": false,
          "CanTouch": true,
          "Color": [
            1,
            0,
            0
          ],
          "Position": [
            0,
            4,
            0
          ],
          "Size": [
            16,
            8,
            16
          ],
          "Transparency": 0.5
        },
        "KillOnTouch": {
          "$path": "src/workspace/KillZone/KillOnTouch.server.luau"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
