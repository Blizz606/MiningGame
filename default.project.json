{
  "name": "MiningGame",
  "tree": {
    "$className": "DataModel",

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,

      "MainGUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,

        "ButtonEffects": {
          "$path": "src/client/MainGUI/ButtonEffects.client.luau"
        },

        "MainController": {
          "$path": "src/client/MainGUI/MainController.client.luau"
        },

        "HUD": {
          "$className": "Frame",
          "$ignoreUnknownInstances": true,

          "LeftHUD": {
            "$className": "Frame",
            "$ignoreUnknownInstances": true,

            "Buttons": {
              "$className": "Frame",
              "$ignoreUnknownInstances": true,

              "ShopButton": {
                "$className": "ImageButton",
                "$ignoreUnknownInstances": true,

                "ShopButtonController": {
                  "$path": "src/client/MainGUI/ShopButton.client.luau"
                }
              }
            }
          }
        }
      },

      "ShopGUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,

        "ShopLayer": {
          "$className": "Frame",
          "$ignoreUnknownInstances": true,

          "CloseController": {
            "$path": "src/client/ShopGUI/CloseController.client.luau"
          },

          "ShopHolder": {
            "$className": "Frame",
            "$ignoreUnknownInstances": true,

            "BuyButtonHoverController": {
              "$path": "src/client/ShopGUI/BuyButtonHoverController.client.luau"
            },

            "ShopController": {
              "$path": "src/client/ShopGUI/ShopController.client.luau"
            },

            "PageController": {
              "$path": "src/client/ShopGUI/PageController.client.luau"
            }
          }
        }
      }
    }
  }
}